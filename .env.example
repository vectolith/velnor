# =============================================================================
# 1. MULTI-PROVIDER AI KEYS (Configure one or more; Velnor routes automatically)
# =============================================================================
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# =============================================================================
# 2. SMS & APPLE iMESSAGE WEBHOOK PROVIDERS (/api/webhooks/imessage)
# =============================================================================
# Twilio Programmable SMS/MMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Sendblue iMessage API
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=

# LoopMessage iMessage API
LOOPMESSAGE_AUTH_KEY=
LOOPMESSAGE_SECRET_KEY=

# =============================================================================
# 3. SLACK BOT INTEGRATION (/api/webhooks/slack)
# =============================================================================
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# =============================================================================
# 4. GOOGLE WORKSPACE OAUTH2 (Gmail & Google Calendar)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# 5. PRODUCTION SECURITY & CRON GATES
# =============================================================================
# Required in production for all private API endpoints. Generate independently
# with: openssl rand -hex 32. Send as x-velnor-secret or Bearer token.
VELNOR_SHARED_SECRET=
# Required in production to encrypt provider/OAuth credentials at rest.
VELNOR_SECRET_KEY=
# Mount durable storage here; production never falls back to temporary storage.
VELNOR_DATA_DIR=.data
# Require an additional credential for settings mutations.
VELNOR_ADMIN_TOKEN=
# Required in production for /api/cron/reminders.
CRON_SECRET=
# Required in production for inbound provider webhook signature verification.
VELNOR_PUBLIC_URL=
SENDBLUE_WEBHOOK_SECRET=
LOOPMESSAGE_WEBHOOK_SECRET=
# Public DNS hostname for the OCI Caddy endpoint (for example api.example.com).
VELNOR_HOST=

