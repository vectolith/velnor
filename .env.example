# =============================================================================
# 1. MULTI-PROVIDER AI KEYS (Configure one or more; Velnor routes automatically)
# =============================================================================
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# =============================================================================
# 2. SMS & APPLE iMESSAGE WEBHOOK PROVIDERS (/api/webhooks/imessage)
# =============================================================================
# Twilio Programmable SMS/MMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Sendblue iMessage API
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=

# LoopMessage iMessage API
LOOPMESSAGE_AUTH_KEY=
LOOPMESSAGE_SECRET_KEY=

# =============================================================================
# 3. SLACK BOT INTEGRATION (/api/webhooks/slack)
# =============================================================================
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# =============================================================================
# 4. GOOGLE WORKSPACE OAUTH2 (Gmail & Google Calendar)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# 5. PRODUCTION SECURITY & CRON GATES (Optional)
# =============================================================================
# Require Bearer/Header token on POST /api/settings in production
VELNOR_ADMIN_TOKEN=
# Require Authorization: Bearer <CRON_SECRET> on /api/cron/reminders
CRON_SECRET=

