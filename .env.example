# =============================================================================
# 1. MULTI-PROVIDER AI KEYS (Configure one or more; Velnor routes automatically)
# =============================================================================
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# =============================================================================
# 2. SMS & APPLE iMESSAGE WEBHOOK PROVIDERS (/api/webhooks/imessage)
# =============================================================================
# Twilio Programmable SMS/MMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Sendblue iMessage API
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=

# LoopMessage iMessage API
LOOPMESSAGE_AUTH_KEY=
LOOPMESSAGE_SECRET_KEY=
LOOPMESSAGE_WEBHOOK_SECRET=

# =============================================================================
# 3. SLACK BOT INTEGRATION (/api/webhooks/slack)
# =============================================================================
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# =============================================================================
# 4. GOOGLE WORKSPACE OAUTH2 (Gmail & Google Calendar)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# 5. PRODUCTION SECURITY & CRON GATES
# =============================================================================
# REQUIRED in production as an outer deployment gate for protected routes.
# Send it as "x-velnor-secret: <secret>" when using the per-user
# Authorization: Bearer <identity-token> header. Without it protected routes answer 503.
VELNOR_SHARED_SECRET=
# Legacy alias, still honoured.
VELNOR_ADMIN_TOKEN=
# Required for authenticated control-plane tenant identity. Generate with: openssl rand -base64 48
VELNOR_TENANT_TOKEN_SECRET=
# Used only by the trusted identity gateway to provision a tenant on first login.
VELNOR_PROVISIONING_SECRET=
VELNOR_TENANT_TOKEN_ISSUER=velnor-auth
VELNOR_TENANT_TOKEN_AUDIENCE=velnor-api
VELNOR_PUBLIC_URL=https://your-public-domain.example
# Persistent volume mount; production must not fall back to ephemeral storage.
VELNOR_DATA_DIR=/app/.data
# Set to 1 only on a local machine, to allow the x-velnor-simulator header.
VELNOR_ALLOW_SIMULATOR=
# Opt in to the local 135M LoRA adapter in front of real models.
VELNOR_LOCAL_LORA=

# =============================================================================
# 6. AGENT LOOP TUNING (all optional)
# =============================================================================
# Model names move fast; pin them here instead of editing code.
VELNOR_MODEL_GEMINI=gemini-3.8-flash
VELNOR_MODEL_OPENAI=gpt-4o
VELNOR_MODEL_ANTHROPIC=claude-sonnet-4-6
VELNOR_IMAGE_MODEL=gemini-3.1-flash-image
# Tool-calling steps per turn, per-call output cap, tool timeout.
VELNOR_MAX_STEPS=6
VELNOR_MAX_OUTPUT_TOKENS=1400
VELNOR_TOOL_TIMEOUT_MS=30000
# Provider transport: request timeout and retry count (429/5xx only).
VELNOR_PROVIDER_TIMEOUT_MS=60000
VELNOR_PROVIDER_RETRIES=2
# Require Authorization: Bearer <CRON_SECRET> on /api/cron/reminders
CRON_SECRET=

