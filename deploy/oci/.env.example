# Copy to .env and fill in. setup-vm.sh generates the three secrets for you if
# this file is still unedited, so the only blanks you must fill are the Slack pair.

NODE_ENV=production
VELNOR_DATA_DIR=/app/.data

# Generated: openssl rand -hex 32
VELNOR_SHARED_SECRET=
VELNOR_SECRET_KEY=
CRON_SECRET=

# Slack (the app A0CGA6K20UE already installed in the Vectolith workspace).
# Bot token: OAuth & Permissions -> Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# Basic Information -> App Credentials -> Signing Secret
SLACK_SIGNING_SECRET=
# The channel velnor posts into
SLACK_CHANNEL=C0CFWLMSP9V

# The other channels are optional: leave blank unless you use them.
TWILIO_AUTH_TOKEN=
SENDBLUE_WEBHOOK_SECRET=

# <public-ip>.sslip.io, or your own domain once it points at this VM.
VELNOR_HOST=localhost
