  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["# Free‑GPU LoRA Fine‑tuning for Velnor + Qwen‑3 8B\n",
                 "\n",
                 "This notebook follows the TL;DR steps you asked for and is ready to run on a free‑GPU platform (Google Colab, Kaggle, etc.).\n",
                 "\n",
                 "## 1️⃣ Install required libraries"]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": ["!pip install -q bitsandbytes==0.43.1 \
                transformers==4.44.0 \
                datasets==2.21.0 \
                peft==0.11.0 \
                accelerate==0.33.0 \
                tqdm"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 2️⃣ Load the 4‑bit quantized Qwen‑3 8B base model (fits on a free T4)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": ["from transformers import AutoModelForCausalLM, AutoTokenizer\n",
                 "import bitsandbytes as bnb\n",
                 "BASE_MODEL = \"Qwen/Qwen2.5-3.8B-Instruct\"\n",
                 "model = AutoModelForCausalLM.from_pretrained(\n",
                 "    BASE_MODEL,\n",
                 "    device_map=\"auto\",\n",
                 "    torch_dtype=\"float16\",\n",
                 "    load_in_4bit=True,\n",
                 "    quantization_config=bnb.nn.Config(\n",
                 "        load_in_4bit=True,\n",
                 "        bnb_4bit_compute_dtype=\"float16\",\n",
                 "        bnb_4bit_use_double_quant=True,\n",
                 "        bnb_4bit_quant_type=\"nf4\"\n",
                 "    )\n",
                 ")\n",
                 "tokenizer = AutoTokenizer.from_pretrained(BASE_MODEL, trust_remote_code=True)\n",
                 "tokenizer.pad_token = tokenizer.eos_token\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 3️⃣ Prepare your custom curriculum (replace the path with your own JSONL)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": ["import json, pathlib\n",
                 "from datasets import Dataset\n",
                 "curr_path = pathlib.Path('training/general_curriculum.jsonl')  # <- change if needed\n",
                 "samples = []\n",
                 "with curr_path.open() as f:\n",
                 "    for line in f:\n",
                 "        obj = json.loads(line)\n",
                 "        prompt = obj.get('prompt', '')\n",
                 "        completion = obj.get('completion', '')\n",
                 "        samples.append({'text': prompt + tokenizer.eos_token + completion})\n",
                 "dataset = Dataset.from_dict({'text': [s['text'] for s in samples]})\n",
                 "def tokenize_fn(example):\n",
                 "    return tokenizer(example['text'], truncation=True, max_length=1024)\n",
                 "tokenized = dataset.map(tokenize_fn, batched=False, num_proc=4)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 4️⃣ Add a LoRA adapter (PEFT)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": ["from peft import LoraConfig, get_peft_model\n",
                 "lora_cfg = LoraConfig(\n",
                 "    r=64,\n",
                 "    lora_alpha=32,\n",
                 "    target_modules=['q_proj','k_proj','v_proj','o_proj'],\n",
                 "    lora_dropout=0.1,\n",
                 "    bias='none',\n",
                 "    task_type='CAUSAL_LM'\n",
                 ")\n",
                 "model = get_peft_model(model, lora_cfg)\n",
                 "model.print_trainable_parameters()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 5️⃣ Train (free‑GPU‑friendly settings)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": ["from transformers import Trainer, TrainingArguments\n",
                 "training_args = TrainingArguments(\n",
                 "    output_dir='lora_adapter',\n",
                 "    per_device_train_batch_size=1,\n",
                 "    gradient_accumulation_steps=8,\n",
                 "    learning_rate=3e-4,\n",
                 "    num_train_epochs=2,\n",
                 "    fp16=True,\n",
                 "    logging_steps=20,\n",
                 "    save_strategy='epoch',\n",
                 "    optim='adamw_torch',\n",
                 "    lr_scheduler_type='cosine',\n",
                 "    warmup_ratio=0.1,\n",
                 ")\n",
                 "trainer = Trainer(\n",
                 "    model=model,\n",
                 "    args=training_args,\n",
                 "    train_dataset=tokenized,\n",
                 ")\n",
                 "trainer.train()\n",
                 "trainer.save_model('lora_adapter_final')\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## 6️⃣ Export the adapter (download or push to HF)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": ["!zip -r lora_adapter.zip lora_adapter_final\n",
                 "from google.colab import files\n",
                 "files.download('lora_adapter.zip')\n"
      ]
    }
  ],
